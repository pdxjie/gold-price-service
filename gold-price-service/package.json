{
  "name": "gold-price-service",
  "version": "1.0.7",
  "description": "本地金价数据采集服务",
  "main": "electron/main.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "desktop": "electron electron/main.js",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win:x64": "npm run build && electron-builder --win nsis --x64",
    "pack:win:arm64": "npm run build && electron-builder --win nsis --arm64",
    "pack:portable": "npm run build && electron-builder --win portable --x64",
    "pack:portable:x64": "npm run build && electron-builder --win portable --x64",
    "pack:mac": "npm run build && electron-builder --mac dmg zip",
    "pack:mac:x64": "npm run build && electron-builder --mac dmg zip --x64",
    "pack:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64",
    "pack:mac:adhoc": "npm run build && electron-builder --mac dmg zip -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "pack:mac:adhoc:x64": "npm run build && electron-builder --mac dmg zip --x64 -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "pack:mac:adhoc:arm64": "npm run build && electron-builder --mac dmg zip --arm64 -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "pack": "npm run build && electron-builder --win nsis portable --x64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "gold",
    "price",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "iconv-lite": "^0.6.3",
    "node-cache": "^5.1.2",
    "sockjs-client": "^1.6.1",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/sockjs-client": "^1.5.4",
    "@types/ws": "^8.18.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.pdxjie.goldpriceservice",
    "productName": "金脉",
    "icon": "electron/renderer/icon.svg",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "electron/renderer/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Jinmai-Setup-${version}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "金脉",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "electron/renderer/icon.svg",
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Jinmai-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    }
  }
}
